# =============================================================================
#  Done.ai Support Assistant — innstillinger uten hemmeligheter
# =============================================================================
#
#  install.ps1 kopierer denne fila til config.env og fyller inn stiene for din
#  maskin. Du trenger normalt ikke redigere noe selv.
#
#  SKRIV ALDRI PASSORD ELLER TOKENS HER.
#  Legitimasjon lagres kryptert i secrets\*.xml via configure-secrets.ps1.
#  Denne fila er utelatt fra Git, men det er ikke grunn nok til a legge
#  hemmeligheter i den.
#
# =============================================================================

# --- XSALE -------------------------------------------------------------------
# Hvilken XSALE-installasjon du logger inn mot. MA vaere satt.
# Serveren har historisk hatt en innebygd standardverdi som pekte pa en ANNEN
# organisasjon. Er denne tom, skal installasjonen feile - ikke gjette.
XSALE_URL=https://plorea.new.xsale.no

# --- ProTouch / MySQL --------------------------------------------------------
PMA_URL=https://ws.tellix.no/phpmyadmin/

# Databasen sporringene kjores mot som standard. Enkeltklienter har egne
# databaser (protouch_client_<id>_<ts>) som oppgis per sporring.
DB_NAME=protouch

# Radgrense per sporring. phpMyAdmin viser 25 rader per side som standard og
# sier ingenting om at resten er utelatt - derfor settes den eksplisitt.
# Overskrides den likevel, varsler serveren om at svaret er ufullstendig.
PMA_MAX_ROWS=10000

# Sekunder. ws.tellix.no er malt til 30-38 sekunder pa innlogging nar den er
# treg; en lavere grense gjor treghet til hard feil.
PMA_LOGIN_TIMEOUT=120
PMA_QUERY_TIMEOUT=180

# --- Kunnskapsbasen ----------------------------------------------------------
# Confluence-instansen. Tokenet ligger DPAPI-kryptert i secrets\confluence.xml,
# aldri her. Uten token virker hjelpesenteret pa support.amendo.no likevel -
# det er offentlig - og kunnskapsstatus() sier hva som mangler.
CONFLUENCE_URL=https://tellix.atlassian.net

# --- Lokale stier ------------------------------------------------------------
# Hvor saksmappene med kundedata legges. Settes av install.ps1.
#
# VIKTIG: denne mappen skal ligge UTENFOR repoet. Kundedata skal ikke kunne
# havne i Git ved et uhell. Ikke flytt den inn i repo-mappen.
AUTO_XSALE_DIR=

# Mappen du apner i Claude Code. Her legges .mcp.json og CLAUDE.md.
# Tom verdi = repoets egen mappe.
PROJECT_ROOT=

# Oppgaveloggen saksassistenten forer. Tom verdi = <AUTO_XSALE_DIR>\task.md
TASK_LEDGER=
