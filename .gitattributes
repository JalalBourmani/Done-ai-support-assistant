# Linjeskift pinnes eksplisitt, ellers gir ulike autocrlf-innstillinger mellom
# maskiner differ der hele fila ser endret ut.
* text=auto

# PowerShell kjores pa Windows. CRLF unngar rare feil i her-strenger.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Alt annet holder LF, som er det verktoyene forventer.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.template text eol=lf
*.env* text eol=lf

# Lasfiler er generert - ikke vis dem i differ.
package-lock.json linguist-generated=true -diff
