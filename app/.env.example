# Kopier til .env.local og pek pa DIN saksmappe.
#
# scripts\install.ps1 setter denne for deg. Kjorer du appen manuelt, ma du
# opprette .env.local selv - appen nekter a starte uten den, framfor a vise en
# tom sakliste som ser ut som en rolig uke.
#
# Mappen skal ligge UTENFOR dette repoet. Kundedata skal ikke i Git.
AUTO_XSALE_DIR=
